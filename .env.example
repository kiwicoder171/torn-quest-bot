# Discord Bot Token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Optional: Default per-key rate limit ceiling (default: 35 req/min, max safe: 50, Torn limit: 100)
DEFAULT_KEY_MAX_RPM=35

# Optional: Minimum seconds between full scan cycles (default: 3.0)
SCAN_INTERVAL_SECONDS=3.0
